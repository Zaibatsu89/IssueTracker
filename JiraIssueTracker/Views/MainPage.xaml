<Page
    x:Class="JiraIssueTracker.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:JiraIssueTracker.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncfusion="using:Syncfusion.UI.Xaml.Editors"
    mc:Ignorable="d">

    <Page.DataContext>
        <local:MainWindowViewModel />
    </Page.DataContext>

    <Page.Resources>
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0D0D0D" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#141414" />
        <SolidColorBrush x:Key="BorderBrush" Color="#333333" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8A8A" />
        <SolidColorBrush x:Key="PassBrush" Color="#00E676" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4DD0E1" />

        <Style x:Key="TagBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style x:Key="CheckListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SelectedSegmentStyle" TargetType="syncfusion:SelectedSegmentBorder">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style x:Key="SegmentItemStyle" TargetType="syncfusion:SfSegmentedItem">
            <Setter Property="Padding" Value="28,14" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BgDarkBrush}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="24,0"
            Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Button
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding BackToQueueCommand}"
                    Foreground="{StaticResource MutedTextBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                        <TextBlock
                            CharacterSpacing="100"
                            FontFamily="Consolas"
                            FontSize="12"
                            Text="BACK TO QUEUE" />
                    </StackPanel>
                </Button>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{StaticResource PassBrush}">
                        <Ellipse.Shadow>
                            <ThemeShadow />
                        </Ellipse.Shadow>
                    </Ellipse>
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{StaticResource MutedTextBrush}"
                        Text="{Binding SystemStatus}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                Grid.Column="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
                <StackPanel>
                    <Border
                        Padding="48"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,16"
                                CharacterSpacing="150"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="TARGET ISSUE" />
                            <TextBlock
                                FontSize="48"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                LineHeight="52"
                                Text="{Binding IssueHeading}"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Margin="0,24,0,0"
                                Orientation="Horizontal"
                                Spacing="16">
                                <Border Style="{StaticResource TagBorderStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Glyph="&#xE8EC;" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="{Binding AreaTag}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource TagBorderStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Glyph="&#xE7BA;" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{StaticResource MutedTextBrush}"
                                            Text="{Binding PriorityTag}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Padding="48" Spacing="24">
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Left"
                                CharacterSpacing="150"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="CHECKS" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="{Binding ProgressText}" />
                        </Grid>

                        <ListView
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource CheckListItemStyle}"
                            ItemsSource="{Binding Checks}"
                            SelectedItem="{Binding SelectedCheck, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:CheckItemViewModel">
                                    <Border
                                        Padding="18"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    CharacterSpacing="120"
                                                    FontFamily="Consolas"
                                                    FontSize="11"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Text="{Binding StepLabel}" />
                                                <TextBlock
                                                    FontSize="20"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource PrimaryTextBrush}"
                                                    Text="{Binding Name}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Text="{Binding ContextLine}" />
                                            </StackPanel>

                                            <Border
                                                Grid.Column="1"
                                                Padding="12,6"
                                                Background="{Binding StatusBrush}">
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding ResultLabel}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0">
                    <StackPanel Margin="48" Spacing="24">
                        <Border Padding="24" Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    CharacterSpacing="150"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="SELECTED CHECK" />
                                <TextBlock
                                    FontSize="34"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding SelectedCheck.Name}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="{Binding SelectedCheck.ContextLine}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="24" Style="{StaticResource PanelStyle}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="10">
                                    <TextBlock
                                        CharacterSpacing="150"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="RESULT" />
                                    <syncfusion:SfSegmentedControl
                                        Height="56"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        ItemBorderThickness="1"
                                        ItemContainerStyle="{StaticResource SegmentItemStyle}"
                                        SelectedIndex="{Binding SelectedCheck.SelectedResultIndex, Mode=TwoWay}"
                                        SelectedSegmentStyle="{StaticResource SelectedSegmentStyle}">
                                        <x:String>OK</x:String>
                                        <x:String>NOK</x:String>
                                        <x:String>OPEN</x:String>
                                    </syncfusion:SfSegmentedControl>
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="Result is verplicht. Remark alleen tonen en eisen bij NOK." />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="10">
                                    <TextBlock
                                        CharacterSpacing="150"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="CURRENT STATE" />
                                    <Border
                                        Padding="14"
                                        Background="{Binding SelectedCheck.StateBackgroundBrush}"
                                        BorderBrush="{Binding SelectedCheck.StatusBrush}"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Foreground="{Binding SelectedCheck.StatusBrush}" Glyph="&#xEA39;" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="14"
                                                Foreground="{Binding SelectedCheck.StatusBrush}"
                                                Text="{Binding SelectedCheck.StateText}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Padding="24"
                            Style="{StaticResource PanelStyle}"
                            Visibility="{Binding SelectedCheck.RemarkVisibility}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    CharacterSpacing="150"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="REMARK" />
                                <TextBox
                                    Height="140"
                                    AcceptsReturn="True"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{Binding SelectedCheck.StatusBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    PlaceholderText="Describe why the result is NOK..."
                                    Text="{Binding SelectedCheck.Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="{Binding SelectedCheck.StatusBrush}"
                                    Text="{Binding SelectedCheck.RemarkValidationMessage}"
                                    Visibility="{Binding SelectedCheck.RemarkValidationVisibility}" />
                            </StackPanel>
                        </Border>

                        <Border Padding="24" Style="{StaticResource PanelStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock
                                    CharacterSpacing="150"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="EXECUTION SUMMARY" />

                                <Grid>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Estimated Effort" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="{Binding EstimatedEffort}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Elapsed" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="{Binding Elapsed}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Assigned To" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="{Binding AssignedTo}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Environment" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontFamily="Consolas"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="{Binding EnvironmentName}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Save Rule" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="{Binding SelectedCheck.SaveHint}"
                                        TextWrapping="WrapWholeWords" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border
                    Grid.Row="1"
                    Padding="24"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            FontSize="12"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="{Binding ActivityMessage}" />

                        <Button
                            Grid.Column="1"
                            Height="56"
                            MinWidth="150"
                            Margin="0,0,12,0"
                            Background="Transparent"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Command="{Binding NextCheckCommand}"
                            Foreground="{StaticResource PrimaryTextBrush}">
                            <TextBlock
                                CharacterSpacing="120"
                                FontFamily="Consolas"
                                FontSize="14"
                                Text="NEXT CHECK" />
                        </Button>

                        <Button
                            Grid.Column="2"
                            Height="56"
                            MinWidth="190"
                            Background="{StaticResource PrimaryTextBrush}"
                            Command="{Binding SaveResultCommand}"
                            Foreground="{StaticResource BgDarkBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock
                                    CharacterSpacing="120"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Text="SAVE RESULT" />
                                <FontIcon FontSize="16" Glyph="&#xE74E;" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
